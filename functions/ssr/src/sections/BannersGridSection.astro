---
import type { CmsFields, InferCmsOutput } from '@@sf/content';
import { bannerListCmsField } from '@@sf/composables/use-banner';
import Picture from '@@sf/components/Picture.astro';

/*
 * Grade de banners — variante Lapidar (joias).
 *
 * NÃO usa o `Banner.vue` do starter. Com `title`/`subtitle` preenchidos ele
 * vira um grid de duas colunas com `p-12 xl:ps-32`, dimensionado para largura
 * total. Numa coluna de 1/3 o texto quebra UMA PALAVRA POR LINHA e a imagem
 * some — apareceu no primeiro print desta loja e é o mesmo defeito que a
 * Bitola já tinha documentado.
 *
 * Aqui a grade segue a regra que vale para o tema inteiro: SEM MOLDURA. Nem
 * borda, nem sombra, nem legenda por cima da foto. A foto é 4/5 (retrato,
 * como a do card) e a legenda vive ABAIXO, centralizada, em serifada de caixa
 * normal. Quem separar um banner do outro é o espaço.
 *
 * Se alguém "corrigir" isto acrescentando card, terá desfeito o argumento do
 * tema. Ver o cabeçalho de `assets/style.css`.
 */
export const cmsFields = ({
  banners: { required: true, ...bannerListCmsField },
}) as const satisfies CmsFields;

export type Props = InferCmsOutput<typeof cmsFields>;
const { banners = [] } = Astro.props;
---

<section class="ui-section">
  <ul class="grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-8">
    {banners.map((banner) => (
      <li>
        <a href={banner.href || '#'} class="group block no-underline">
          <div class="overflow-hidden bg-base-100">
            <Picture
              src={banner.img}
              alt={banner.alt || ''}
              widths={[400, 640, 828]}
              sizes="(min-width: 640px) 33vw, 100vw"
              loading="lazy"
              class="aspect-[4/5] w-full object-cover transition-transform
              duration-700 md:group-hover:scale-105"
            />
          </div>
          {(banner.title || banner.subtitle) && (
            <div class="pt-5 text-center">
              {banner.title && (
                <h3
                  class="font-brand text-2xl font-light leading-tight
                  text-base-900 transition-colors group-hover:text-secondary"
                >{banner.title}</h3>
              )}
              {banner.subtitle && (
                <p class="mt-2 ui-material">{banner.subtitle}</p>
              )}
            </div>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>
